{
  "name": "whelo",
  "version": "1.0.0",
  "description": "A quiet, cinematic Windows media player with wheel speed lock and local AI subtitle sync.",
  "author": "XNtriCT",
  "license": "MIT",
  "homepage": "https://github.com/XNtriCT/whelo",
  "repository": {
    "type": "git",
    "url": "https://github.com/XNtriCT/whelo.git"
  },
  "bugs": {
    "url": "https://github.com/XNtriCT/whelo/issues"
  },
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "models": "node scripts/fetch-models.mjs",
    "test": "node --test",
    "check:syntax": "node --check electron-main.cjs && node --check preload.cjs",
    "verify": "npm run check:syntax && npm test && npm run build",
    "dist:installer": "vite build && electron-builder --win nsis --publish never",
    "dist:dir": "vite build && electron-builder --win dir"
  },
  "build": {
    "appId": "com.whelo.player",
    "productName": "WHELO Media Player",
    "copyright": "Copyright © 2026 WHELO",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.cjs",
      "package.json",
      "build/icon.ico"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "fileAssociations": [
      {
        "ext": "mkv",
        "name": "Matroska Video",
        "description": "Matroska Video File",
        "role": "Viewer"
      },
      {
        "ext": "mp4",
        "name": "MP4 Video",
        "description": "MPEG-4 Video File",
        "role": "Viewer"
      },
      {
        "ext": "avi",
        "name": "AVI Video",
        "description": "Audio Video Interleave File",
        "role": "Viewer"
      },
      {
        "ext": "mov",
        "name": "QuickTime Video",
        "description": "QuickTime Movie File",
        "role": "Viewer"
      },
      {
        "ext": "webm",
        "name": "WebM Video",
        "description": "WebM Video File",
        "role": "Viewer"
      },
      {
        "ext": "wmv",
        "name": "Windows Media Video",
        "description": "Windows Media Video File",
        "role": "Viewer"
      },
      {
        "ext": "flv",
        "name": "Flash Video",
        "description": "Flash Video File",
        "role": "Viewer"
      },
      {
        "ext": "m4v",
        "name": "M4V Video",
        "description": "MPEG-4 Video File",
        "role": "Viewer"
      },
      {
        "ext": "ts",
        "name": "MPEG-TS Video",
        "description": "MPEG Transport Stream",
        "role": "Viewer"
      },
      {
        "ext": "m2ts",
        "name": "BDAV Video",
        "description": "Blu-ray BDAV Video",
        "role": "Viewer"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WHELO Media Player",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "lucide": "^1.61.0"
  }
}
